# Supabase (frontend - Vite embeds these into client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server only - NEVER use VITE_ prefix for this)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin password (server only - NEVER use VITE_ prefix)
# Primary rotates on every logout; backup never rotates (2nd option when clipboard fails).
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_BACKUP_PASSWORD=your-static-backup-password
