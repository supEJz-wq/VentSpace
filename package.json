{
  "name": "ventspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && vite",
    "server": "node backend/server/index.js",
    "dev:all": "concurrently -k \"npm:server\" \"npm:dev\"",
    "build": "cd frontend && vite build",
    "lint": "eslint .",
    "preview": "cd frontend && vite preview",
    "start": "node backend/server/index.js",
    "test:e2e": "playwright test --config qa/automation/playwright.config.js",
    "test:e2e:headed": "playwright test --config qa/automation/playwright.config.js --headed",
    "test:e2e:report": "playwright show-report qa/automation/playwright-report"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^6.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12"
  }
}
